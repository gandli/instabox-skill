# Copy to .env (gitignored) only when a key is needed; a browser sign-in is the
# normal path and stores credentials in ~/.config/instabox.

# Optional: for CI or an agent without a browser. Never commit a real key.
INSTABOX_API_KEY=ibk_your_key_here

# Optional: point the CLI/API at another server. This is the default.
INSTABOX_API_URL=https://api.instabox.sh
